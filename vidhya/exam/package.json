{
  "name": "@vidhya/exam",
  "version": "0.1.0",
  "private": true,
  "description": "The student-facing /exam app: Today, Mock, Marks. Built into the Exam Brain image and served at /exam.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "gen:demo": "vite-node scripts/gen-demo-items.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@vidhya/ui": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "katex": "^0.16.47"
  }
}
